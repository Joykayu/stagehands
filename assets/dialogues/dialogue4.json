        },
        "right": {
            "chara": "Player",
            "mood": "neutral",
            "focus": true
        },
        "line": {
            "speaker": "right",
            "text": "[i]You start walking towards a pile of wooden planks of all sizes.[/i]",
            "audio": null
        },
        "next": "line_8"
    },
    "line_8": {
        "type": "line",
        "left": {
            "chara": "Sarah",
            "mood": "irritated",
            "focus": true
        },
        "right": {
            "chara": "Player",
            "mood": "neutral",
            "focus": false
        },
        "line": {
            "speaker": "left",
            "text": "Can you believe what the boss said? Personally, I don’t care. We’ll do it, and we’ll do it well!",
            "audio": "s4r100.mp3"
        },
        "next": "line_9"
    },
    "line_9": {
        "type": "line",
        "left": {
            "chara": "Sarah",
