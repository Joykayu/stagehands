        },
        "right": {
            "chara": "Player",
            "mood": "neutral",
            "focus": false
        },
        "line": {
            "speaker": "left",
            "text": "In the end, they need us more than we need them. We’d adapt.",
            "audio": "s4r109.mp3"
        },
        "next": "line_18"
    },
