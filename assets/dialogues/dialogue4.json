        "next": "line_16"
    },
    "line_16": {
        "type": "line",
        "left": {
            "chara": "Sarah",
            "mood": "neutral",
            "focus": true
        },
        "right": {
            "chara": "Player",
            "mood": "neutral",
            "focus": false
        },
        "line": {
            "speaker": "left",
            "text": "I’m not saying we should just give it all up, burn it down, and start from nothing, living in huts and whatnot. I’m just saying, with or without the money, we’d always find a way to make people live and dance.",
            "audio": "s4r108.mp3"
        },
