        "right": {
            "chara": "Player",
            "mood": "neutral",
            "focus": true
        },
        "line": {
            "speaker": "right",
            "text": "I see..",
            "audio": null
        },
        "next": "line_4"
    },
    "line_4": {
        "type": "line",
        "left": {
            "chara": "Sarah",
            "mood": "irritated",
            "focus": true
        },
        "right": {
            "chara": "Player",
            "mood": "neutral",
            "focus": false
        },
        "line": {
            "speaker": "left",
            "text": "Alright, let’s get this done, quick and efficient. We don’t really have a choice!",
            "audio": "s4r096.mp3"
        },
