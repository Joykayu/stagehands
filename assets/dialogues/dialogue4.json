        },
        "right": {
            "chara": "Player",
            "mood": "neutral",
            "focus": false
        },
        "line": {
            "speaker": "left",
            "text": "Walk with me to get the materials.",
            "audio": "s4r098.mp3"
        },
        "next": "line_7"
    },
    "line_7": {
        "type": "line",
        "left": {
