        "right": {
            "chara": "Player",
            "mood": "neutral",
            "focus": true
        },
        "line": {
            "speaker": "right",
            "text": "No, in fact he was nice.",
            "audio": null
        },
        "next": "line_2"
    },
    "line_2": {
        "type": "line",
        "left": {
            "chara": "Sarah",
